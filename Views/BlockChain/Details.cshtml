@model BlockChain_FP_ITStep.Models.Block

@{
    ViewData["Title"] = "Block Details";
}

<h2 class="mb-3">Block Details</h2>

@if (Model == null)
{
    <div class="alert alert-danger">Block not found.</div>
}
else
{
    // DisplayTemplate Block.cshtml
    @Html.DisplayFor(m => m)   

    // Add block transactions display
    @if (Model.Transactions != null && Model.Transactions.Count > 0)
    {
        <h4 class="mt-4">Transactions</h4>

        <table class="table table-bordered table-sm">
            <thead class="table-light">
                <tr>
                    <th>From</th>
                    <th>To</th>
                    <th>Amount</th>
                    <th>Fee</th>
                    <th>Confirmations</th>
                    <th>Note</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in Model.Transactions)
                {
                    bool isCoinbase = tx.FromAddress == "COINBASE";
                    var rowClass = isCoinbase ? "table-warning" : "";

                    int confirmations = ViewBag.LastBlockIndex - Model.Index + 1;
                    confirmations = Math.Min(confirmations, 6); // максимум 6 cofirms (аналог бтс)

                    <tr class="@rowClass">
                        <td>@tx.FromAddress</td>
                        <td>@tx.ToAddress</td>
                        <td class="fw-semibold">@tx.Amount</td>
                        <td>@tx.Fee</td>

                        <td>
                            @if (isCoinbase)
                            {
                                <span class="text-muted">--</span>
                            }
                            else
                            {
                                @($"{confirmations}/6")
                            }
                        </td>

                        <td>@tx.Note</td>
                    </tr>
                }
            </tbody>

        </table>
    }
    else
    {
        <div class="mt-4 alert alert-info">No transactions in this block</div>
    }

}

<a asp-action="Index" class="btn btn-secondary mt-3">← Back to list</a>



@section Scripts {
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text)
                .then(() => console.log("Copied"))
                .catch(err => console.error("Copy failed", err));
        }
    </script>
}