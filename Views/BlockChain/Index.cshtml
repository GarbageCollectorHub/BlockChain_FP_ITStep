@* Control Panel Section *@
<div class="control-panel">

        <!--Node Selector -->
    <form method="get" asp-action="Index" class="node-selector mb-2">
        <label class="me-1">Node:</label>
        <select name="nodeId">
            @foreach (var n in ViewBag.Nodes)
            {
                <option value="@n" selected="@(n == ViewBag.NodeId ? "selected" : null)">@n</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-outline-primary ms-2">Switch</button>
    </form>
    @* Generate Key Button *@
    <div class="keygen-section">
        <button type="button"
                class="btn btn-keygen"
                data-bs-toggle="modal"
                data-bs-target="#keyModal">
            <i class="bi bi-key-fill"></i>Generate Key Pair
        </button>
    </div>

    @* Main Controls Grid *@
    <div class="row g-3">

        @* Mining Controls Card *@
        <div class="col-lg-8">
            <div class="control-card">
                <div class="card-title">
                    <i class="bi bi-minecart-loaded"></i>Mining Controls
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center">

                    @* Demo Setup *@
                    <form method="post" asp-action="DemoSetup" class="d-inline">
                        <input type="hidden" name="nodeId" value="@nodeId" />
                        <button type="submit" class="btn btn-control-secondary btn-sm">
                            <i class="bi bi-play-circle me-1"></i> Demo Setup
                        </button>
                    </form>

                    @* Mining Form *@
                    <form method="post" asp-action="MinePending" class="d-flex gap-2 flex-grow-1">
                        <input type="hidden" name="nodeId" value="@nodeId" />
                        <input type="text"
                               name="privateKey"
                               class="form-control form-control-sm form-control-modern flex-grow-1"
                               placeholder="Enter private key for mining"
                               style="max-width: 350px;" />
                        <button type="submit" class="btn btn-control-primary btn-sm">
                            <i class="bi bi-play-fill me-1"></i> Start Mining
                        </button>
                    </form>
                </div>

                @* Mining Progress Bar *@
                <div id="miningProgress" class="mt-3" style="display:none;">
                    <div class="progress" style="height: 6px; background: #e9ecef;">
                        <div id="progressBarInline"
                             class="progress-bar bg-success"
                             role="progressbar"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             style="width: 0%;">
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small id="progressText" class="text-muted">⛏️ Mining block...</small>
                        <small id="attemptsText" class="text-muted">0 attempts/s</small>
                    </div>
                </div>
            </div>
        </div>

        @* Difficulty Settings Card *@
        <div class="col-lg-4">
            <div class="control-card h-100">
                <div class="card-title">
                    <i class="bi bi-sliders"></i>Difficulty Settings
                </div>

                <form method="post" asp-action="SetDifficulty" novalidate>
                    <input type="hidden" name="nodeId" value="@nodeId" />
                    <div class="input-group input-group-sm">
                        <input type="number"
                               name="difficulty"
                               class="form-control form-control-modern"
                               placeholder="New difficulty"
                               min="1"
                               />
                        <button type="submit" class="btn btn-control-primary">
                            Apply
                        </button>
                    </div>
                    <div class="current-value">
                        Current difficulty: <strong>@ViewBag.Difficulty</strong>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

